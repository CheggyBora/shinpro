# Настройки сервера. На боевой машине скопировать в .env и заполнить.
# Файл .env в систему контроля версий не кладём: здесь пароли.

# --- База ---------------------------------------------------------------
# Без этой строки берётся SQLite рядом с сервером — только для разработки
SERVER_DATABASE_URL=postgresql+psycopg2://tire:ПАРОЛЬ@localhost:5432/tire_shop

# --- Ключи --------------------------------------------------------------
# Обязательно задать. Без него после каждого перезапуска сервера
# всем клиентам придётся входить заново.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVER_SECRET_KEY=

# Ключ, которым программа в цеху доказывает, что она — это она.
# Тот же ключ вписывается в настройки программы шиномонтажа.
SERVER_SYNC_KEY=

# --- Почта --------------------------------------------------------------
# Через неё клиент подтверждает вход. Письма бесплатны, в отличие от SMS.
# log  — код пишется в журнал сервера, письмо не уходит (для разработки)
# smtp — обычная отправка через почтовый ящик
SERVER_MAIL_PROVIDER=log

# Яндекс:  smtp.yandex.ru, порт 465, SSL
# Mail.ru: smtp.mail.ru,   порт 465, SSL
SERVER_MAIL_HOST=
SERVER_MAIL_PORT=465
SERVER_MAIL_SSL=1

# ВАЖНО: нужен не пароль от почтового ящика, а отдельный «пароль
# приложения» — и у Яндекса, и у Mail.ru обычный пароль для внешних
# программ не работает. Создаётся в настройках безопасности ящика.
SERVER_MAIL_USER=
SERVER_MAIL_PASSWORD=
SERVER_MAIL_FROM=

# --- Дашборд -------------------------------------------------------------
# Первый владелец. Завести его из самого дашборда нельзя: заводить людей
# имеет право только владелец, а его ещё нет. Остальных он добавит сам.
SERVER_OWNER_PHONE=
SERVER_OWNER_NAME=

# Сколько дней живёт вход сотрудника. Меньше, чем у клиента: доступ к
# выручке и зарплатам ценнее кабинета с историей визитов
SERVER_STAFF_TOKEN_DAYS=7

# --- ПИН-код -------------------------------------------------------------
SERVER_PIN_LENGTH=4
SERVER_PIN_FAILURES=5

# --- SMS ----------------------------------------------------------------
# Код на первом входе идёт сюда: и клиенту, и сотруднику. Пока провайдер
# не подключён (log), код пишется в журнал сервера и никому не уходит —
# значит, войти не сможет никто, кроме того, у кого есть доступ к журналу.
# smsru — SMS.RU, самый ходовой в России.
SERVER_SMS_PROVIDER=log
SERVER_SMS_API_KEY=
SERVER_SMS_SENDER=

# --- Прочее -------------------------------------------------------------
SERVER_SHOP_NAME=Шиномонтаж «РИФ»
SERVER_TOKEN_DAYS=30
SERVER_DEBUG=0

# Нужно, только если появится сайт. Мобильному приложению не требуется.
SERVER_CORS_ORIGINS=
