[Unit]
Description=Сервер шиномонтажа: кабинет клиента и дашборд
After=network.target postgresql.service
Wants=postgresql.service

# Сервер падал — перезапускаем, но не бесконечно: если он падает по
# кругу, пусть остановится, и это будет видно, а не тонет в журнале.
#
# Эти два ключа работают только в [Unit]. В [Service] systemd их молча
# не замечает, и перезапуск становится вечным: на первой же установке
# счётчик дошёл до 194, прежде чем это заметили
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=tire
Group=tire
WorkingDirectory=/opt/tire-server
EnvironmentFile=/opt/tire-server/.env

# Два рабочих процесса: одного хватает на десяток точек, второй нужен,
# чтобы сервер отвечал, пока первый занят долгим запросом
ExecStart=/opt/tire-server/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3

# Чужого на диске серверу трогать нечего
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Копии складывает отдельная служба tire-backup, а не сервер: сюда
# ему писать не нужно и нельзя. Пока эта папка была здесь, служба не
# стартовала вовсе — ProtectSystem=strict требует, чтобы каждый путь
# отсюда существовал, а папка создавалась позже по ходу установки
ReadWritePaths=/opt/tire-server

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tire-server

[Install]
WantedBy=multi-user.target
