[Unit]
Description=Разослать созревшие напоминания клиентам
After=postgresql.service tire-server.service

[Service]
Type=oneshot
User=tire
Group=tire
WorkingDirectory=/opt/tire-server
EnvironmentFile=/opt/tire-server/.env
ExecStart=/opt/tire-server/venv/bin/python manage.py notify
SyslogIdentifier=tire-notify
