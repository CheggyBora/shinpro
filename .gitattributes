# Перевод строк.
#
# Скрипты развёртывания пишутся на Windows, а выполняются на Linux.
# С виндовыми переносами bash отвечает «\r: command not found», и
# разобраться в этом с первого раза не получается ни у кого. Поэтому
# для всего, что уезжает на сервер, перевод строк закреплён.

*.sh            text eol=lf

# Перехватчики git расширения не имеют, а запускает их всё тот же bash.
# Без этой строки файл уезжает на сервер с виндовыми переносами и не
# запускается вовсе: git молча не выполняет перехватчик, и push
# проходит «успешно», ничего не сделав
post-receive    text eol=lf
pre-receive     text eol=lf
post-update     text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.ini           text eol=lf
*.example       text eol=lf
.env.example    text eol=lf

# Двоичное не трогаем
*.db            binary
*.exe           binary
*.jpg           binary
*.png           binary
*.ttf           binary
*.pdf           binary
