modules = ["python-3.11", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["fluxbox", "freetype", "glibcLocales", "x11vnc", "xorg.xauth", "xorg.xorgserver", "xvfb-run", "evince", "dejavu_fonts"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Tire Shop App"

[[workflows.workflow]]
name = "Tire Shop App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run_app.sh"

[workflows.workflow.metadata]
outputType = "vnc"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 44287
externalPort = 3000

[[ports]]
localPort = 46623
externalPort = 3001

[agent]
expertMode = true
